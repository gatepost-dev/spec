{
  "version": 1,
  "function": "parse",
  "description": "Forms, lengths, characters and legacy codes.",
  "cases": [
    {
      "id": "parse-001",
      "description": "parses the canonical form",
      "input": "EK-01-A03-FK-01",
      "options": {},
      "expect": {
        "ok": true,
        "compact": "EK01A03FK01",
        "canonical": "EK-01-A03-FK-01",
        "display": "EK 01 A03 FK 01",
        "precision": "unit",
        "segments": {
          "state": "EK",
          "lga": "01",
          "district": "A03",
          "area": "FK",
          "unit": "01"
        }
      }
    },
