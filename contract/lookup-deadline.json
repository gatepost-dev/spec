{
  "version": 1,
  "id": "lookup-deadline",
  "description": "A wait past the total deadline ends the call at once, with the last error.",
  "client": {
    "apiKey": "nipost_test_mock_l3",
    "timeoutMs": 200,
    "maxRetries": 1
  },
  "calls": [
    {
      "method": "lookup",
      "code": "FC-01-Z99-ZZ-01",
      "level": 1
    }
  ],
  "responses": [
    {
      "status": 503,
      "body": {
        "error": {
          "code": "unavailable",
          "message": "try again"
        }
      },
      "headers": {
        "Retry-After": "2"
      }
    }
  ],
  "expect": {
    "attempts": 1,
    "outcomes": [
      {
        "error": {
          "code": "server_error",
          "status": 503,
          "apiCode": "unavailable",
          "retryAfterMs": 2000
        }
      }
    ]
  }
}
