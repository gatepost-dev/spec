{
  "version": 1,
  "id": "lookup-network-error",
  "description": "A dropped connection is retried, and the last one gives network_error.",
  "client": {"apiKey": "nipost_test_mock_l3"},
  "calls": [{"method": "lookup", "code": "FC-01-Z99-ZZ-01", "level": 1}],
  "responses": [{"drop": true}],
  "expect": {
    "attempts": 3,
    "waitsMs": [{"min": 500, "max": 750}, {"min": 1000, "max": 1250}],
    "outcomes": [
      {"error": {"code": "network_error", "status": null, "apiCode": null, "retryAfterMs": null}}
    ]
  }
}
