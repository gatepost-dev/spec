{
  "version": 1,
  "id": "autocomplete-district",
  "description": "The client sends normalised text, keeps a label, and gives null for a bad code.",
  "client": {"apiKey": "nipost_test_mock_l3"},
  "calls": [{"method": "autocomplete", "q": "fc 01 z"}],
  "responses": [
    {
      "status": 200,
      "body": {
        "data": {
          "segment": "district",
          "suggestions": [{"code": "Z99", "label": "SYNTHETIC DISTRICT"}, {"code": "ZZZZ"}]
        }
      }
    }
  ],
  "expect": {
    "attempts": 1,
    "request": {
      "method": "GET",
      "path": "/v1/search/autocomplete",
      "query": {"q": "FC01Z"},
      "apiKey": "nipost_test_mock_l3"
    },
    "outcomes": [
      {
        "result": {
          "segment": "district",
          "suggestions": [
            {"code": "Z99", "label": "SYNTHETIC DISTRICT", "postcode": "FC-01-Z99"},
            {"code": "ZZZZ", "label": null, "postcode": null}
          ]
        }
      }
    ]
  }
}
