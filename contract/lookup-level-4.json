{
  "version": 1,
  "id": "lookup-level-4",
  "description": "A body with other_building_info gives level 4.",
  "client": {
    "apiKey": "nipost_test_mock_l3"
  },
  "calls": [
    {
      "method": "lookup",
      "code": "FC-01-Z99-ZZ-01",
      "level": 4
    }
  ],
  "responses": [
    {
      "status": 200,
      "body": {
        "data": {
          "postcode": "FC-01-Z99-ZZ-01",
          "valid": true,
          "other_building_info": {}
        }
      }
    }
  ],
  "expect": {
    "attempts": 1,
    "outcomes": [
      {
        "result": {
          "postcode": "FC-01-Z99-ZZ-01",
          "valid": true,
          "status": null,
          "levelRequested": 4,
          "levelReceived": 4,
          "administrativeAddress": null,
          "recentHouseAddress": null,
          "buildingUseStatus": null
        }
      }
    ]
  }
}
