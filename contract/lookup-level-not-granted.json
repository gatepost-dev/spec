      "method": "GET",
      "path": "/v1/lookup",
      "query": {"code": "FC-01-Z99-ZZ-01", "level": "2"},
      "apiKey": "nipost_test_mock_l1"
    },
    "outcomes": [
      {
        "error": {
          "code": "forbidden",
          "status": 403,
          "apiCode": "level_not_granted",
          "retryAfterMs": null
        }
      }
    ]
  }
