{
  "version": 1,
  "id": "lookup-malformed-body",
  "description": "A 200 whose body is not JSON gives server_error, with no retry.",
  "client": {"apiKey": "nipost_test_mock_l3"},
  "calls": [{"method": "lookup", "code": "FC-01-Z99-ZZ-01", "level": 1}],
  "responses": [
    {
      "status": 200,
      "headers": {"Content-Type": "text/html"},
      "text": "<html><body>Sign in to the network</body></html>"
    }
  ],
  "expect": {
    "attempts": 1,
    "outcomes": [
      {"error": {"code": "server_error", "status": 200, "apiCode": null, "retryAfterMs": null}}
    ]
  }
}
