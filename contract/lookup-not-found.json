{
  "version": 1,
  "id": "lookup-not-found",
  "description": "A postcode that the gateway does not know gives valid false, not an error.",
  "client": {"apiKey": "nipost_test_mock_l3"},
  "calls": [{"method": "lookup", "code": "fc01 z99 zz02", "level": 1}],
  "responses": [{"fixture": "lookup/not-found"}],
  "expect": {
    "attempts": 1,
    "request": {
      "method": "GET",
      "path": "/v1/lookup",
      "query": {"code": "FC-01-Z99-ZZ-02", "level": "1"},
      "apiKey": "nipost_test_mock_l3"
    },
    "outcomes": [
      {
        "result": {
          "postcode": "FC-01-Z99-ZZ-02",
          "valid": false,
          "status": "not_found",
          "levelRequested": 1,
          "levelReceived": 1,
          "administrativeAddress": null,
          "recentHouseAddress": null,
          "buildingUseStatus": null
        }
      }
    ]
  }
}
