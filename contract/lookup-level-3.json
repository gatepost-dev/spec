{
  "version": 1,
  "id": "lookup-level-3",
  "description": "A level 3 body in NIPOST's documented shape adds the building use status.",
  "client": {"apiKey": "nipost_test_mock_l3"},
  "calls": [{"method": "lookup", "code": "FC-01-Z99-ZZ-01", "level": 3}],
  "responses": [{"fixture": "lookup/valid-level-3"}],
  "expect": {
    "attempts": 1,
    "outcomes": [
      {
        "result": {
          "postcode": "FC-01-Z99-ZZ-01",
          "valid": true,
          "status": null,
          "levelRequested": 3,
          "levelReceived": 3,
          "administrativeAddress": {
            "stateName": "FEDERAL CAPITAL TERRITORY",
            "lgaName": "SYNTHETIC LGA",
            "localityName": "SYNTHETIC LOCALITY",
            "zone": "NORTH CENTRAL"
          },
          "recentHouseAddress": "1 SYNTHETIC STREET, SYNTHETIC LOCALITY",
          "buildingUseStatus": "residential"
        }
      }
    ]
  }
}
