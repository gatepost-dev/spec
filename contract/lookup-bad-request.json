{
  "version": 1,
  "id": "lookup-bad-request",
  "description": "Another status from 400 to 499 gives invalid_input, with no retry.",
  "client": {"apiKey": "nipost_test_mock_l3"},
  "calls": [{"method": "lookup", "code": "FC-01-Z99-ZZ-01", "level": 1}],
  "responses": [{"fixture": "errors/invalid-request"}],
  "expect": {
    "attempts": 1,
    "outcomes": [
      {
        "error": {
          "code": "invalid_input",
          "status": 400,
          "apiCode": "invalid_request",
          "retryAfterMs": null
        }
      }
    ]
  }
}
