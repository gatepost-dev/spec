{
  "version": 1,
  "id": "lookup-retry-502",
  "description": "A 502 is retried after the first wait, and the second attempt succeeds.",
  "client": {"apiKey": "nipost_test_mock_l3"},
  "calls": [{"method": "lookup", "code": "FC-01-Z99-ZZ-01", "level": 1}],
  "responses": [
    {"status": 502, "body": {"error": {"code": "unavailable", "message": "try again"}}},
    {"fixture": "lookup/valid-level-1"}
  ],
  "expect": {
    "attempts": 2,
    "waitsMs": [{"min": 500, "max": 750}],
    "outcomes": [
      {
        "result": {
          "postcode": "FC-01-Z99-ZZ-01",
          "valid": true,
          "status": "valid",
          "levelRequested": 1,
          "levelReceived": 1,
          "administrativeAddress": null,
          "recentHouseAddress": null,
          "buildingUseStatus": null
        }
      }
    ]
  }
}
