{
  "version": 1,
  "id": "lookup-missing-valid",
  "description": "A 200 with no valid field gives unexpected_response, with no retry.",
  "client": {
    "apiKey": "nipost_test_mock_l3"
  },
  "calls": [
    {
      "method": "lookup",
      "code": "FC-01-Z99-ZZ-01",
      "level": 1
    }
  ],
  "responses": [
    {
      "status": 200,
      "body": {
        "data": {
          "postcode": "FC-01-Z99-ZZ-01"
        }
      }
    }
  ],
  "expect": {
    "attempts": 1,
    "outcomes": [
      {
        "error": {
          "code": "unexpected_response",
          "status": 200,
          "apiCode": null,
          "retryAfterMs": null
        }
      }
    ]
  }
}
