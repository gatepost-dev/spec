{
  "version": 1,
  "id": "lookup-cache-hit",
  "description": "With cacheTtlMs above 0, a second identical call gets the kept result.",
  "client": {"apiKey": "nipost_test_mock_l3", "cacheTtlMs": 60000},
  "order": "sequential",
  "calls": [
    {"method": "lookup", "code": "FC-01-Z99-ZZ-01", "level": 1},
    {"method": "lookup", "code": "FC-01-Z99-ZZ-01", "level": 1}
  ],
  "responses": [{"fixture": "lookup/valid-level-1"}],
  "expect": {
    "attempts": 1,
    "outcomes": [
      {
        "result": {
          "postcode": "FC-01-Z99-ZZ-01",
          "valid": true,
          "status": "valid",
          "levelRequested": 1,
          "levelReceived": 1,
          "administrativeAddress": null,
          "recentHouseAddress": null,
          "buildingUseStatus": null
        }
      },
      {
        "result": {
          "postcode": "FC-01-Z99-ZZ-01",
          "valid": true,
          "status": "valid",
          "levelRequested": 1,
          "levelReceived": 1,
          "administrativeAddress": null,
          "recentHouseAddress": null,
          "buildingUseStatus": null
        }
      }
    ]
  }
}
