{
  "version": 1,
  "id": "lookup-building-use-only",
  "description": "A body with building_use_status alone gives level 3, with no address.",
  "client": {
    "apiKey": "nipost_test_mock_l3"
  },
  "calls": [
    {
      "method": "lookup",
      "code": "FC-01-Z99-ZZ-01",
      "level": 3
    }
  ],
  "responses": [
    {
      "status": 200,
      "body": {
        "data": {
          "postcode": "FC-01-Z99-ZZ-01",
          "valid": true,
          "building_use_status": "residential"
        }
      }
    }
  ],
  "expect": {
    "attempts": 1,
    "outcomes": [
      {
        "result": {
          "postcode": "FC-01-Z99-ZZ-01",
          "valid": true,
          "status": null,
          "levelRequested": 3,
          "levelReceived": 3,
          "administrativeAddress": null,
          "recentHouseAddress": null,
          "buildingUseStatus": "residential"
        }
      }
    ]
  }
}
