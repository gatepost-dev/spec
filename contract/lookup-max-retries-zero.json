{
  "version": 1,
  "id": "lookup-max-retries-zero",
  "description": "With maxRetries 0, a 503 gives server_error after one attempt.",
  "client": {"apiKey": "nipost_test_mock_l3", "maxRetries": 0},
  "calls": [{"method": "lookup", "code": "FC-01-Z99-ZZ-01", "level": 1}],
  "responses": [
    {"status": 503, "body": {"error": {"code": "unavailable", "message": "try again"}}}
  ],
  "expect": {
    "attempts": 1,
    "outcomes": [
      {
        "error": {
          "code": "server_error",
          "status": 503,
          "apiCode": "unavailable",
          "retryAfterMs": null
        }
      }
    ]
  }
}
