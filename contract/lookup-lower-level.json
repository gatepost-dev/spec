{
  "version": 1,
  "id": "lookup-lower-level",
  "description": "A body with fewer fields than the level asked for gives the lower level.",
  "client": {
    "apiKey": "nipost_test_mock_l3"
  },
  "calls": [
    {
      "method": "lookup",
      "code": "FC-01-Z99-ZZ-01",
      "level": 3
    }
  ],
  "responses": [
    {
      "fixture": "lookup/valid-level-1"
    }
  ],
  "expect": {
    "attempts": 1,
    "outcomes": [
      {
        "result": {
          "postcode": "FC-01-Z99-ZZ-01",
          "valid": true,
          "status": "valid",
          "levelRequested": 3,
          "levelReceived": 1,
          "administrativeAddress": null,
          "recentHouseAddress": null,
          "buildingUseStatus": null
        }
      }
    ]
  }
}
