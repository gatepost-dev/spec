{
  "version": 1,
  "id": "lookup-retry-after-ten",
  "description": "A 429 with Retry-After of 10 seconds, the longest wait, is retried after it.",
  "client": {
    "apiKey": "nipost_test_mock_l3"
  },
  "calls": [
    {
      "method": "lookup",
      "code": "FC-01-Z99-ZZ-01",
      "level": 1
    }
  ],
  "responses": [
    {
      "fixture": "errors/rate-limited",
      "headers": {
        "Retry-After": "10"
      }
    },
    {
      "fixture": "lookup/valid-level-1"
    }
  ],
  "expect": {
    "attempts": 2,
    "waitsMs": [
      {
        "min": 10000,
        "max": 10000
      }
    ],
    "outcomes": [
      {
        "result": {
          "postcode": "FC-01-Z99-ZZ-01",
          "valid": true,
          "status": "valid",
          "levelRequested": 1,
          "levelReceived": 1,
          "administrativeAddress": null,
          "recentHouseAddress": null,
          "buildingUseStatus": null
        }
      }
    ]
  }
}
