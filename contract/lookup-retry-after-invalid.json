{
  "version": 1,
  "id": "lookup-retry-after-invalid",
  "description": "A 503 with an invalid Retry-After is retried after the client's own wait.",
  "client": {
    "apiKey": "nipost_test_mock_l3"
  },
  "calls": [
    {
      "method": "lookup",
      "code": "FC-01-Z99-ZZ-01",
      "level": 1
    }
  ],
  "responses": [
    {
      "status": 503,
      "body": {
        "error": {
          "code": "unavailable",
          "message": "try again"
        }
      },
      "headers": {
        "Retry-After": "soon"
      }
    },
    {
      "fixture": "lookup/valid-level-1"
    }
  ],
  "expect": {
    "attempts": 2,
    "waitsMs": [
      {
        "min": 500,
        "max": 750
      }
    ],
    "outcomes": [
      {
        "result": {
          "postcode": "FC-01-Z99-ZZ-01",
          "valid": true,
          "status": "valid",
          "levelRequested": 1,
          "levelReceived": 1,
          "administrativeAddress": null,
          "recentHouseAddress": null,
          "buildingUseStatus": null
        }
      }
    ]
  }
}
