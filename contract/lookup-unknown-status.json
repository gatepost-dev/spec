{
  "version": 1,
  "id": "lookup-unknown-status",
  "description": "A status that client.md does not list stays text in the result.",
  "client": {"apiKey": "nipost_test_mock_l3"},
  "calls": [{"method": "lookup", "code": "FC-01-Z99-ZZ-01", "level": 1}],
  "responses": [
    {
      "status": 200,
      "body": {"data": {"postcode": "FC-01-Z99-ZZ-01", "valid": true, "status": "pending"}}
    }
  ],
  "expect": {
    "attempts": 1,
    "outcomes": [
      {
        "result": {
          "postcode": "FC-01-Z99-ZZ-01",
          "valid": true,
          "status": "pending",
          "levelRequested": 1,
          "levelReceived": 1,
          "administrativeAddress": null,
          "recentHouseAddress": null,
          "buildingUseStatus": null
        }
      }
    ]
  }
}
